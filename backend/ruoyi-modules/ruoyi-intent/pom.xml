<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-intent</artifactId>

    <description>
        ruoyi-intent 意图注入包
        —— 开箱即用的"意图即服务"能力：把系统管理、监控运维等既有能力
        包装成宿主工具（IntentTool），并用 YAML 声明意图规范与声明式事实规则。
        删除本模块不影响框架运行（只是没有这些意图），这就是平台与业务的解耦边界。
    </description>

    <dependencies>

        <!-- 意图即服务开发框架（含内嵌 AI 意图 SDK） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-intent</artifactId>
        </dependency>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- api模块（UserService / DeptService / RoleService / ConfigService 等 SPI） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-api</artifactId>
        </dependency>

        <!-- 系统模块（宿主工具直调其 Service，进程内、同事务、同权限） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- 数据库服务 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- 缓存服务（缓存概览工具） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- satoken（工具内二次鉴权：即使模型被诱导，也越不过宿主权限） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <!-- 日志记录（工具执行留痕进操作日志） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- 接口文档 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

    </dependencies>

</project>
